#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_MAINFRAME ICON "CppFeaExampleApp.ico"

IDD_MAIN DIALOGEX 0, 0, 400, 78
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "C++ FEA example"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Checkbot:", IDC_STATIC, 7, 10, 56, 8
    EDITTEXT        IDC_CHECKBOT_PATH, 66, 8, 327, 14, ES_AUTOHSCROLL
    LTEXT           "Project folder:", IDC_STATIC, 7, 30, 56, 8
    EDITTEXT        IDC_PROJECT_PATH, 66, 28, 327, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Start Checkbot", IDC_START_CHECKBOT, 263, 56, 74, 15
    PUSHBUTTON      "Close", IDCANCEL, 343, 56, 50, 15
END
