<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<ItemGroup Label="ProjectConfigurations">
		<ProjectConfiguration Include="Debug|x64">
			<Configuration>Debug</Configuration>
			<Platform>x64</Platform>
		</ProjectConfiguration>
		<ProjectConfiguration Include="Release|x64">
			<Configuration>Release</Configuration>
			<Platform>x64</Platform>
		</ProjectConfiguration>
	</ItemGroup>

	<PropertyGroup Label="Globals">
		<VCProjectVersion>18.0</VCProjectVersion>
		<ProjectGuid>{5794D7F5-C9BB-428B-A070-056717BBB58B}</ProjectGuid>
		<RootNamespace>BimApiLinkCppFeaExample</RootNamespace>
		<WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
		<TargetFramework>net10.0</TargetFramework>
		<EnableManagedPackageReferenceSupport>true</EnableManagedPackageReferenceSupport>
		<!-- A native application finds the .NET assemblies only next to this DLL, so the packages are copied there. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

	<PropertyGroup Label="Configuration">
		<ConfigurationType>DynamicLibrary</ConfigurationType>
		<PlatformToolset>v145</PlatformToolset>
		<CharacterSet>Unicode</CharacterSet>
		<CLRSupport>NetCore</CLRSupport>
		<!-- A C++/CLI DLL hides its import library by default, but the native application links to it to call
		     StartCheckbot. -->
		<IgnoreImportLibrary>false</IgnoreImportLibrary>
		<UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
		<WholeProgramOptimization Condition="'$(Configuration)' == 'Release'">true</WholeProgramOptimization>
	</PropertyGroup>

	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

	<PropertyGroup>
		<OutDir>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\</OutDir>
	</PropertyGroup>

	<ItemDefinitionGroup>
		<ClCompile>
			<PreprocessorDefinitions>BIMAPILINKCPPFEAEXAMPLE_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
			<AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(MSBuildThisFileDirectory)..;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
			<LanguageStandard>stdcpp17</LanguageStandard>
			<ConformanceMode>true</ConformanceMode>
			<WarningLevel>Level4</WarningLevel>
			<TreatWarningAsError>true</TreatWarningAsError>
			<!-- Raised while reading the referenced assemblies, not this code: C4679 for .NET members C++/CLI cannot
			     import, C4691 for the .NET Standard types the IdeaStatiCa packages use, and C4945 for a type that .NET and
			     Microsoft.Extensions.DependencyModel both define. -->
			<DisableSpecificWarnings>4679;4691;4945;%(DisableSpecificWarnings)</DisableSpecificWarnings>
		</ClCompile>
	</ItemDefinitionGroup>

	<ItemGroup>
		<ClInclude Include="BimApi\CrossSectionByName.h" />
		<ClInclude Include="BimApi\Member1D.h" />
		<ClInclude Include="BimApi\Segment3D.h" />
		<ClInclude Include="CheckbotLink.h" />
		<ClInclude Include="Importers\CombinationImporter.h" />
		<ClInclude Include="Importers\CrossSectionImporter.h" />
		<ClInclude Include="Importers\LoadCaseImporter.h" />
		<ClInclude Include="Importers\LoadGroupImporter.h" />
		<ClInclude Include="Importers\MaterialImporter.h" />
		<ClInclude Include="Importers\MemberImporter.h" />
		<ClInclude Include="Importers\NodeImporter.h" />
		<ClInclude Include="Importers\ResultsImporter.h" />
		<ClInclude Include="Model.h" />
	</ItemGroup>

	<ItemGroup>
		<ClCompile Include="CheckbotLink.cpp" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="IdeaStatiCa.BimApiLink" />
		<PackageReference Include="IdeaStatiCa.Plugin" />
		<PackageReference Include="IdeaStatiCa.PluginLogger" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BimApiLinkCppFeaExampleBases\BimApiLinkCppFeaExampleBases.csproj" />
	</ItemGroup>

	<Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

</Project>
