<UserControl x:Class="NorsokChecker.Controls.Joint3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAFBFC">
    <Grid>
        <Viewport3D x:Name="Viewport" ClipToBounds="True">
            <Viewport3D.Camera>
                <!-- Orthographic keeps the members' relative sizes readable, which a perspective
                     camera would distort; positioned on an oblique axis so a joint in a global
                     plane is not seen edge-on. Width is set from the model's extent in Load(). -->
                <OrthographicCamera x:Name="Camera"
                                    Position="1.2,-1.6,1.0"
                                    LookDirection="-1.2,1.6,-1.0"
                                    UpDirection="0,0,1"
                                    Width="1.5"/>
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <!-- two lights so a tube reads as round from any angle -->
                        <DirectionalLight Color="#FFFFFF" Direction="-1.0,1.4,-1.2"/>
                        <DirectionalLight Color="#606060" Direction="1.0,-0.6,0.8"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- member bodies are added here at runtime, one ModelVisual3D each -->
            <ModelVisual3D x:Name="MembersVisual">
                <ModelVisual3D.Content>
                    <Model3DGroup x:Name="MembersGroup"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

        <TextBlock x:Name="Placeholder" Text="Select a connection to see its members"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#9E9E9E" FontSize="11"/>

        <TextBlock x:Name="HintLabel" Text="" Margin="8,6,8,0"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Foreground="#607D8B" FontSize="11"/>
    </Grid>
</UserControl>
