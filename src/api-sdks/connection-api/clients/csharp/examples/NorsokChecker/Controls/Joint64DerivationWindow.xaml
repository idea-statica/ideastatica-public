<Window x:Class="NorsokChecker.Controls.Joint64DerivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NORSOK §6.4 — derivation"
        Width="900" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The same renderer the report uses, so the two cannot disagree. WebView2 is already a
             dependency for the Report tab, so this adds nothing. -->
        <wv2:WebView2 Grid.Row="0" x:Name="Web"/>

        <TextBlock Grid.Row="1" x:Name="Fallback" Visibility="Collapsed"
                   Margin="16" TextWrapping="Wrap" Foreground="#B71C1C"/>
    </Grid>
</Window>
