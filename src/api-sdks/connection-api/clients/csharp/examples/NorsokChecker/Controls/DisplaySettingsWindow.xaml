<Window x:Class="NorsokChecker.Controls.DisplaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Units and precision"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <!-- Plain WPF, like PageSetupWindow: a separate window does not inherit MainWindow's Material
         Design resources, and pulling them in for one grid is not worth the coupling.

         Laid out after IDEA StatiCa's own Preferences → Presentation units: one row per quantity,
         columns unit / decimals / format. Two departures from the first attempt here, both taken
         from that dialog:

           - decimals are TYPED, not picked from a list. A list has to choose a range, and any
             range is arbitrary — A² already prints 4 places and a small gap could want 5.
           - format is a per-row COMBO, not a checkbox. It carries three values instead of two, and
             it appears on every row, so the table does not look moth-eaten where a checkbox was
             not applicable. -->
    <StackPanel Margin="18" MinWidth="460">

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="1" Text="unit" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="decimals" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="format" FontWeight="SemiBold" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Force" VerticalAlignment="Center"/>
            <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="CbForce" Margin="0,2,8,2"/>
            <TextBox   Grid.Row="1" Grid.Column="2" x:Name="TxtForceDp" Margin="0,2,8,2"
                       PreviewTextInput="Digits_PreviewTextInput"/>
            <ComboBox  Grid.Row="1" Grid.Column="3" x:Name="CbForceFmt" Margin="0,2,0,2"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Moment" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtMomentUnit" VerticalAlignment="Center"
                       Foreground="#78909C"/>
            <TextBox   Grid.Row="2" Grid.Column="2" x:Name="TxtMomentDp" Margin="0,2,8,2"
                       PreviewTextInput="Digits_PreviewTextInput"/>
            <ComboBox  Grid.Row="2" Grid.Column="3" x:Name="CbMomentFmt" Margin="0,2,0,2"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Stress" VerticalAlignment="Center"/>
            <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="CbStress" Margin="0,2,8,2"/>
            <TextBox   Grid.Row="3" Grid.Column="2" x:Name="TxtStressDp" Margin="0,2,8,2"
                       PreviewTextInput="Digits_PreviewTextInput"/>
            <ComboBox  Grid.Row="3" Grid.Column="3" x:Name="CbStressFmt" Margin="0,2,0,2"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Cross-section dimensions"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="CbLength" Margin="0,2,8,2"/>
            <TextBox   Grid.Row="4" Grid.Column="2" x:Name="TxtLengthDp" Margin="0,2,8,2"
                       PreviewTextInput="Digits_PreviewTextInput"/>
            <ComboBox  Grid.Row="4" Grid.Column="3" x:Name="CbLengthFmt" Margin="0,2,0,2"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Thickness, gaps and other small dimensions"
                       VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#546E7A"/>
            <TextBlock Grid.Row="5" Grid.Column="1" Text="as above" VerticalAlignment="Center"
                       Foreground="#78909C" FontStyle="Italic"
                       ToolTip="The section unit, with its own precision."/>
            <TextBox   Grid.Row="5" Grid.Column="2" x:Name="TxtGapDp" Margin="0,2,8,2"
                       PreviewTextInput="Digits_PreviewTextInput"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Area" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtAreaUnit" VerticalAlignment="Center"
                       Foreground="#78909C"/>
            <TextBox   Grid.Row="6" Grid.Column="2" x:Name="TxtAreaDp" Margin="0,2,8,2"
                       PreviewTextInput="Digits_PreviewTextInput"/>
            <ComboBox  Grid.Row="6" Grid.Column="3" x:Name="CbAreaFmt" Margin="0,2,0,2"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Second moment of area"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtInertiaUnit" VerticalAlignment="Center"
                       Foreground="#78909C"/>
            <TextBox   Grid.Row="7" Grid.Column="2" x:Name="TxtInertiaDp" Margin="0,2,8,2"
                       PreviewTextInput="Digits_PreviewTextInput"/>
            <ComboBox  Grid.Row="7" Grid.Column="3" x:Name="CbInertiaFmt" Margin="0,2,0,2"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Angle" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="8" Grid.Column="1" Text="°" VerticalAlignment="Center"
                       Foreground="#78909C"
                       ToolTip="Degrees, fixed by §6.4.3.1."/>
            <TextBox   Grid.Row="8" Grid.Column="2" x:Name="TxtAngleDp" Margin="0,2,8,2"
                       PreviewTextInput="Digits_PreviewTextInput"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Coefficient" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="9" Grid.Column="1" Text="&#8211;" VerticalAlignment="Center"
                       Foreground="#78909C"
                       ToolTip="β, γ, τ, Q, A², φ — dimensionless."/>
            <TextBox   Grid.Row="9" Grid.Column="2" x:Name="TxtRatioDp" Margin="0,2,8,2"
                       PreviewTextInput="Digits_PreviewTextInput"/>

            <!-- Utilisations, the K/X/Y shares and the three terms of eq (6.57) are all percentages,
                 which makes this the most-used row in the table and it was missing. -->
            <TextBlock Grid.Row="10" Grid.Column="0" Text="Utilisation, shares" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="10" Grid.Column="1" Text="%" VerticalAlignment="Center"
                       Foreground="#78909C"/>
            <TextBox   Grid.Row="10" Grid.Column="2" x:Name="TxtPercentDp" Margin="0,2,8,2"
                       PreviewTextInput="Digits_PreviewTextInput"/>
        </Grid>

        <!-- One line. This used to say the derivations were exempt; they are not. -->
        <TextBlock TextWrapping="Wrap" Foreground="#78909C" FontSize="11" Margin="0,10,0,16"
                   Text="Applies to every printed value, derivations included."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnRestore" Content="Default" Width="80" Height="26"
                    Margin="0,0,8,0" Click="Restore_Click"/>
            <Button x:Name="BtnOk" Content="OK" Width="80" Height="26" IsDefault="True"
                    Margin="0,0,8,0" Click="Ok_Click"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="26" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
