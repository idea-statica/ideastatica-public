<Window x:Class="NorsokChecker.Controls.PageSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Page setup"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <!-- Plain WPF, like Joint64DerivationWindow: a separate window does not inherit MainWindow's
         Material Design resources, and pulling them in for four fields is not worth the coupling. -->
    <StackPanel Margin="18" MinWidth="300">

        <TextBlock Text="Paper" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <RadioButton x:Name="RbA4" Content="A4 (210 × 297 mm)" GroupName="Size"
                         IsChecked="True" Margin="0,0,16,0"/>
            <RadioButton x:Name="RbLetter" Content="Letter (8.5 × 11 in)" GroupName="Size"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="RbPortrait" Content="Portrait" GroupName="Orientation"
                         IsChecked="True" Margin="0,0,16,0"/>
            <RadioButton x:Name="RbLandscape" Content="Landscape" GroupName="Orientation"/>
        </StackPanel>

        <TextBlock Text="Margins [mm]" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Left" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtLeft" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="Top" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox   Grid.Row="0" Grid.Column="4" x:Name="TxtTop" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TxtRight"/>
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Bottom" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox   Grid.Row="1" Grid.Column="4" x:Name="TxtBottom"/>
        </Grid>

        <!-- Not a cosmetic switch: WebView2 prints backgrounds OFF by default, and this report
             encodes PASS/FAIL and the utilisation scale in background colour. Off means a PDF where
             a failing joint looks like a passing one. -->
        <CheckBox x:Name="ChkBackgrounds" IsChecked="True" Margin="0,0,0,4"
                  Content="Print background colours"/>
        <TextBlock Text="Off drops the PASS/FAIL colours and the utilisation scale from the PDF."
                   FontSize="11" Foreground="#78909C" TextWrapping="Wrap" Margin="22,0,0,14"/>

        <TextBlock x:Name="LblError" Visibility="Collapsed" Foreground="#B71C1C"
                   FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnRestore" Content="Restore defaults" Click="RestoreDefaults_Click"
                    Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Cancel" IsCancel="True" Padding="14,4" Margin="0,0,8,0"/>
            <Button x:Name="BtnOk" Content="OK" IsDefault="True" Click="Ok_Click" Padding="18,4"/>
        </StackPanel>
    </StackPanel>
</Window>
