<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Opt this standalone example out of the repo-wide central package management -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Single-file self-contained publish -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- KaTeX, embedded so the report and the derivation window render their formulas WITHOUT
         INTERNET. They used to be pulled from cdn.jsdelivr.net, which meant an offline machine
         showed the raw LaTeX source ($$\dfrac{...}$$) instead of the equations — unusable in a
         report that is a deliverable and often read where there is no network.

         The CSS has its fonts inlined as data: URIs, so nothing resolves a relative path: the
         report is handed to WebView2 as a STRING (NavigateToString) and may be saved and moved,
         so there is no base URL for url(fonts/...) to work against. woff2 only — WebView2 is
         Chromium, and ttf+woff would triple the size for formats nothing will request.

         MIT, same as this repo. LICENSE.katex.txt sits beside the files and THIRD_PARTY_NOTICES.md
         records it, mirroring what reference/python_prototype/lib does for its MathJax copy. -->
    <EmbeddedResource Include="Resources\katex.min.js" />
    <EmbeddedResource Include="Resources\katex.min.css" />
    <EmbeddedResource Include="Resources\katex-auto-render.min.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests read the real MainWindow's start-up state (chapter toggles off, log collapsed,
         the connections grid's columns). Controls named in XAML are internal, and rebuilding copies
         of them in the test would keep passing after someone edited MainWindow.xaml — which is the
         change those tests exist to catch. -->
    <InternalsVisibleTo Include="UT_NorsokChecker" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Published SDK from nuget.org instead of the in-repo client project, so this example
         builds standalone against a released API version. -->
    <PackageReference Include="IdeaStatiCa.ConnectionApi" Version="26.0.4.1707" />
  </ItemGroup>

  <ItemGroup>
    <!-- Product telemetry (Sentry / Seq / Google Analytics user events). IdeaStatiCa.Diagnostics is
         not published to any feed, so this reaches out of ideastatica-public into the surrounding
         monorepo: the app builds only from a full C:\Dev\IdeaStatiCa checkout, not from a
         standalone clone of the public repo. -->
    <ProjectReference Include="..\..\..\..\..\..\..\..\Common\IdeaStatiCa.Diagnostics\IdeaStatiCa.Diagnostics.csproj" />
  </ItemGroup>

</Project>
