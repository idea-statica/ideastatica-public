<Window x:Class="NorsokChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:NorsokChecker.Controls"
        Title="IDEA StatiCa — NORSOK N-004 Connection Checker"
        Width="1780" Height="1040"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- proportional-bar widths for the load-effect selector (WPF has no percentage width) -->
        <controls:FractionToStarConverter x:Key="FractionToStar"/>
        <controls:FractionToRestStarConverter x:Key="FractionToRestStar"/>
        <!-- for a row background computed per row (the utilisation tint) -->
        <controls:ColorToBrushConverter x:Key="ColorToBrush"/>
        <!-- "M_y,chord [kNm]" -> M with y,chord as a real subscript. Also the only way an
             underscore survives a column header at all: WPF reads it as an access-key marker
             and eats it, which is why one §6.4 table showed "My" and the other "M_y,Rd". -->
        <controls:SubscriptHeaderConverter x:Key="SubscriptHeader"/>

        <!-- Every §6.4 header with a symbol in it uses this: the subscript is typeset, and the
             swallowed-underscore problem is fixed in one place rather than per column. -->
        <Style x:Key="SubscriptColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding Converter={StaticResource SubscriptHeader}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="VerticalContentAlignment" Value="Bottom"/>
        </Style>

        <!-- Column header for the §6.4 table. One line only: the GROUP name lives in its own banner
             above the grid (Group64Band, filled by SyncGroup64Band), spanning and centred over the
             columns it covers.

             It used to be a two-line header with the group name on the first line of the group's
             FIRST column and a blank line on the rest. That reads as a label for that one column —
             "Classification" over K, "Resistance" over N_Rd — rather than as a heading over three,
             which is the opposite of what the grouping is for. WPF's DataGrid has no colspan, so a
             real merged cell has to be drawn outside the grid and kept aligned to it. -->
        <Style x:Key="Grouped64Header" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- Through the subscript converter, so "M_y,Rd" is typeset rather than
                             printed with a literal underscore. This table kept its underscores
                             where the brace-force table lost them (WPF eats "_" as an access key)
                             purely because it had a TextBlock here — that accident is what made the
                             two tables disagree. -->
                        <ContentPresenter Content="{Binding Converter={StaticResource SubscriptHeader}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="VerticalContentAlignment" Value="Bottom"/>
        </Style>

        <!-- The FIRST column of each group carries a vertical rule on its left, so the groups are
             visibly divided rather than only labelled.

             The python table gets this for free: it uses real colspan header cells over a table
             whose every cell is bordered, so the group boundary IS a table line. WPF's DataGrid has
             no colspan, so the boundary has to be drawn — and it has to be drawn on the CELLS too
             (Group64CellStart below), or the division stops at the header and the eleven data
             columns still read as one run. -->
        <Style x:Key="Grouped64HeaderStart" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource Grouped64Header}">
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
        </Style>

        <Style x:Key="Group64CellStart" TargetType="DataGridCell"
               BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="BorderBrush" Value="#DCE3E8"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
        </Style>

        <!-- IDEA StatiCa brand -->
        <Color x:Key="IdeaOrange">#F57C00</Color>
        <Color x:Key="IdeaDark">#2D2D2D</Color>
        <SolidColorBrush x:Key="IdeaOrangeBrush" Color="{StaticResource IdeaOrange}"/>
        <SolidColorBrush x:Key="IdeaDarkBrush" Color="{StaticResource IdeaDark}"/>
        <!-- Norsok accent -->
        <Color x:Key="NorsokTeal">#00838F</Color>
        <Color x:Key="NorsokTealLight">#4FB3BF</Color>
        <SolidColorBrush x:Key="NorsokTealBrush" Color="{StaticResource NorsokTeal}"/>

        <!-- Verdict colours. Defined once here because the same five states appear in the
             connection list and in the per-check tables, and they were drifting apart.

             Four degrees, not two, and the middle two are NOT fails:
               FAIL       red    - checked, and it does not comply
               PASS       green  - checked, and it complies
               PARTIAL    amber  - everything checked passed, but part was not assessed
               QUALIFIED  amber  - everything WAS checked and passed, but on geometry outside
                                   the 6.4.3.1 validity range, so the resistance is an
                                   extrapolation of formulas fitted inside it
               N/A        grey   - NOTHING was checked; no verdict was ever reached
             PARTIAL and QUALIFIED share the amber deliberately: both are a pass a reader
             must not take at face value, and they differ in WHY, which the Note column
             states. N/A and PARTIAL used to share it too, and that was wrong - "outside the
             scope of 6.4" was indistinguishable from "checked, with a gap". Grey says "no
             answer here", which is what N/A is. The amber foreground also sat next to the
             IDEA brand orange, so it read as an accent rather than a caution - hence the
             darker amber text below. -->
        <SolidColorBrush x:Key="VerdictFailBg"     Color="#FFEBEE"/>
        <SolidColorBrush x:Key="VerdictFailFg"     Color="#C62828"/>
        <SolidColorBrush x:Key="VerdictPassBg"     Color="#E8F5E9"/>
        <SolidColorBrush x:Key="VerdictPassFg"     Color="#1B5E20"/>
        <SolidColorBrush x:Key="VerdictPartialBg"  Color="#FFF8E1"/>
        <SolidColorBrush x:Key="VerdictPartialFg"  Color="#8D6E00"/>
        <SolidColorBrush x:Key="VerdictNaBg"       Color="#EEEEEE"/>
        <SolidColorBrush x:Key="VerdictNaFg"       Color="#546E7A"/>

        <!-- Button styles -->
        <Style x:Key="IdeaPrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="{StaticResource IdeaOrangeBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="md:ElevationAssist.Elevation" Value="Dp2"/>
        </Style>
        <Style x:Key="IdeaOutlineButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="BorderBrush" Value="{StaticResource IdeaOrangeBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource IdeaOrangeBrush}"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header — IDEA StatiCa primary with orange accent ═══ -->
        <Border Grid.Row="0" md:ElevationAssist.Elevation="Dp4">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource IdeaDark}"/>
            </Border.Background>
            <Grid Margin="20,12,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: IDEA StatiCa brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Orange bar accent (like IDEA logo) -->
                    <Border Width="4" Height="32" Background="{StaticResource IdeaOrangeBrush}"
                            CornerRadius="2" Margin="0,0,12,0"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IDEA" FontSize="19" FontWeight="Bold" Foreground="#F57C00"/>
                            <TextBlock Text=" StatiCa" FontSize="19" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Connection API" FontSize="10" Foreground="#9E9E9E"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: divider + Norsok feature badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Border Background="#3E3E3E" Width="1" Height="28" Margin="20,0,20,0"/>
                    <Grid Width="28" Height="28" Margin="0,0,10,0">
                        <Ellipse Fill="#00838F" Opacity="0.2"/>
                        <md:PackIcon Kind="ShieldCheck" Width="16" Height="16"
                                     Foreground="#4FB3BF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="NORSOK N-004" FontSize="14" FontWeight="SemiBold" Foreground="#4FB3BF"/>
                        <TextBlock Text="Connection Compliance Checker" FontSize="10" Foreground="#78909C"
                                   Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: version -->
                <TextBlock Grid.Column="2" Text="v0.2" FontSize="10" Foreground="#616161"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ Configuration Card — only shown on the Check tab ═══ -->
        <md:Card x:Name="ConfigCard" Grid.Row="1" Margin="16,12,16,4" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <!-- Collapsed once a project has loaded (see LoadProject_Click): the settings are needed
                 to get started and are dead weight afterwards, but they stay reachable by hand
                 because changing the service or the file is a normal thing to want next. -->
            <Expander x:Name="ApiConfigExpander" IsExpanded="True" md:ExpanderAssist.HorizontalHeaderPadding="16"
                      Background="Transparent">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Cog" Width="18" Height="18" VerticalAlignment="Center"
                                     Foreground="{StaticResource IdeaOrangeBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="API Configuration" FontWeight="Medium"/>
                    </StackPanel>
                </Expander.Header>
                <Grid Margin="16,4,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="RbSpawn" Content="Spawn local API" IsChecked="True"
                                     Checked="ServiceMode_Changed"
                                     Margin="0,0,24,0" Style="{StaticResource MaterialDesignRadioButton}"/>
                        <RadioButton x:Name="RbAttach" Content="Attach to running service"
                                     Checked="ServiceMode_Changed"
                                     Style="{StaticResource MaterialDesignRadioButton}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LblApiPath" Text="IDEA StatiCa folder:"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtApiPath"
                             Text="C:\Program Files\IDEA StatiCa\StatiCa 26.0"
                             md:HintAssist.Hint="Path to installation or service URL"
                             Margin="0,0,8,0"/>
                    <Button Grid.Row="1" Grid.Column="2" x:Name="BtnBrowseApiPath" Content="Browse..."
                            Click="BrowseApiPath_Click"
                            Style="{StaticResource IdeaOutlineButton}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Project file (.ideaCon):"
                               VerticalAlignment="Center" Margin="0,8,12,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtProjectFile"
                             md:HintAssist.Hint="Select an .ideaCon project file"
                             Margin="0,8,8,0"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseProject_Click"
                            Style="{StaticResource IdeaOutlineButton}" Margin="0,8,0,0"/>
                </Grid>
            </Expander>
        </md:Card>

        <!-- ═══ Main workspace ═══ -->
        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="16,8,16,8"
                    SelectionChanged="MainTabs_SelectionChanged"
                    Style="{StaticResource MaterialDesignNavigationRailTabControl}">

            <!-- Tab 1: Check -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <md:PackIcon Kind="ShieldCheck" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Check" HorizontalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="12" LastChildFill="True">

                    <!-- Action bar — chapter toggles left, buttons right -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- First, because it qualifies every chapter that follows: it says WHICH
                                 load effects are assessed, not which check is run. On by default — a
                                 load effect switched off in IDEA StatiCa is one the engineer decided
                                 not to design for, so honouring that is the expected reading of the
                                 model rather than a special mode. -->
                            <CheckBox x:Name="ChkActiveLoadEffectsOnly" Content="Active load effects only"
                                      IsChecked="True" Margin="0,0,20,0"
                                      ToolTip="Assess only the load effects switched on in the .ideaCon. Unchecked, every load effect in the file is assessed, including the ones the model has disabled."/>
                            <!-- One checkbox per registered chapter, built in code from
                                 ChapterRegistry (see BuildChapterToggles) rather than listed here:
                                 a chapter that exists but has no toggle can never be run, and a
                                 toggle for a chapter that no longer exists is worse. All OFF by
                                 default — running a check is the user's decision. -->
                            <TextBlock Text="Chapters:" FontWeight="Medium" VerticalAlignment="Center"
                                       Foreground="#546E7A" Margin="0,0,10,0"/>
                            <StackPanel x:Name="ChapterToggles" Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnLoadProject" Click="LoadProject_Click"
                                    Style="{StaticResource IdeaOutlineButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="FolderOpen" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Load Project" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Shown only while a run is in progress. The token reaches the API calls
                                 themselves, so a running calculation is aborted rather than waited
                                 out (see _checkCts). What the service does with the abandoned run is
                                 not verified, which is why the tooltip does not claim it stops there. -->
                            <Button x:Name="BtnCancelCheck" IsEnabled="False" Click="CancelCheck_Click"
                                    Style="{StaticResource IdeaOutlineButton}" Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    ToolTip="Stop the check. Results already produced are kept; connections not reached are left unchecked.">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="StopCircleOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRunCheck" IsEnabled="False" Click="RunCheck_Click"
                                    Style="{StaticResource IdeaPrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="PlayCircleOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Run Norsok Check" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Connections first (the connection is what everything below is about, with
                         the 3D view of the selected one beside it), then the members table.

                         A Grid with GridSplitters rather than a DockPanel: the useful split depends
                         on the project - how many connections, how big the joint - so it is the
                         user's to set, and a splitter needs real rows/columns to resize. Row 0 is
                         the connection+3D band, row 1 the grip, row 2 the members table.
                         Star heights on both content rows: the grip then trades one against the
                         other instead of either growing the tab. -->
                    <Grid>
                        <!-- 1:1, measured not guessed: the members table needs 241 px to show 7 rows
                             without scrolling (row 21.4 + header 35.4 + expander chrome 56 —
                             LayoutMeasurementProbe). The original 2:1 gave it 181 and 3:2 only 216;
                             an even split clears it with room to spare, and the connections band
                             above keeps enough for its own rows plus the 3D view. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*" MinHeight="80"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,2" x:Name="TopBand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="600" MinWidth="440"/>
                            </Grid.ColumnDefinitions>
                            <!-- Same size and indent as the Members heading below, and no icon on
                                 either - the two tables are peers, so their headings must read alike. -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Connections" FontWeight="Medium"
                                       Margin="16,0,0,4" VerticalAlignment="Center"/>
                            <!-- Connections grid — takes the width the 3D view does not. Its own
                                 scrollbar appears when the splitter squeezes it (VerticalScrollBar-
                                 Visibility="Auto" below), which is the point of giving it a MinHeight
                                 rather than letting it push the layout. -->
                            <DataGrid Grid.Row="1" Grid.Column="0" x:Name="ConnectionsGrid" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      SelectionChanged="ConnectionsGrid_SelectionChanged"
                                      md:DataGridAssist.CellPadding="10 6"
                                      VerticalScrollBarVisibility="Auto"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NorsokPass}" Value="FAIL">
                                                <Setter Property="Background" Value="{StaticResource VerdictFailBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource VerdictFailFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NorsokPass}" Value="PASS">
                                                <Setter Property="Background" Value="{StaticResource VerdictPassBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource VerdictPassFg}"/>
                                            </DataTrigger>
                                            <!-- grey, NOT amber: no verdict was reached, so this is neither
                                                 a pass nor a milder fail. It used to share PARTIAL's amber. -->
                                            <DataTrigger Binding="{Binding NorsokPass}" Value="N/A">
                                                <Setter Property="Background" Value="{StaticResource VerdictNaBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource VerdictNaFg}"/>
                                            </DataTrigger>
                                            <!-- amber: everything CHECKED passed, but part of the joint was
                                                 not assessed. Verified against the verdict logic - PARTIAL is
                                                 only reached when anyFailed is false, so it is a qualified
                                                 pass, not a fail. It keeps amber; only N/A moved to grey. -->
                                            <DataTrigger Binding="{Binding NorsokPass}" Value="PARTIAL">
                                                <Setter Property="Background" Value="{StaticResource VerdictPartialBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource VerdictPartialFg}"/>
                                            </DataTrigger>
                                            <!-- amber too, and for the same reason: every brace WAS checked and
                                                 passed, but on geometry outside the 6.4.3.1 validity range, so
                                                 the resistance is an extrapolation. A qualified pass, not a
                                                 fail and not unassessed. Without this trigger the row kept the
                                                 default background and read as an ordinary result. -->
                                            <DataTrigger Binding="{Binding NorsokPass}" Value="QUALIFIED">
                                                <Setter Property="Background" Value="{StaticResource VerdictPartialBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource VerdictPartialFg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- Assess this connection? A DataGridTemplateColumn, not a
                                         DataGridCheckBoxColumn: the grid is IsReadOnly (which keeps
                                         the data columns from being edited), and a CheckBoxColumn
                                         honours that and comes out greyed. A CheckBox inside a
                                         template is a control, not a cell editor, so it stays live.
                                         UpdateSourceTrigger=PropertyChanged because the default
                                         LostFocus would not write back before Run is pressed. -->
                                    <DataGridTemplateColumn Header="" Width="SizeToCells" MinWidth="34"
                                                            CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ToolTip="Assess this connection in the next run"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <!-- Active / total load effects, read from the model at load time.
                                         An em dash until they have been read — "0 / 0" would state
                                         that the connection has no load effects. -->
                                    <DataGridTextColumn Header="Active LC / Total" Binding="{Binding LoadEffectsDisplay}"
                                                        Width="SizeToHeader" MinWidth="110"/>
                                    <!-- SizeToCells: the longest status is "Outside §6.4 scope (7 conditions)",
                                         which a fixed 130 px truncated -->
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}"
                                                        Width="SizeToCells" MinWidth="130"/>
                                    <DataGridTextColumn Header="Max Utilization" Binding="{Binding MaxUtilizationDisplay}" Width="130"/>
                                    <DataGridTextColumn Header="Norsok" Binding="{Binding NorsokPass}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Vertical grip: 3D view width vs connection list width. Spans both rows
                                 so it can be grabbed level with the headings too. -->
                            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                          Width="8" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="Transparent"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                          Cursor="SizeWE"
                                          ToolTip="Drag to resize the 3D view">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Grid Background="Transparent">
                                            <Border Width="2" Height="36" CornerRadius="1"
                                                    Background="#C4CCD6" x:Name="Pill"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Pill" Property="Background" Value="#2E6FB0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>
                            <!-- No MinHeight here: the 3D view follows the band's height, which the
                                 horizontal splitter drives. A MinHeight would fight the splitter and
                                 stop the band from shrinking. RowSpan 2 so it is as tall as the
                                 heading plus the list beside it. -->
                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                    BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2">
                                <controls:Joint3DView x:Name="Joint3D"
                                                      MemberClicked="Joint3D_MemberClicked"/>
                            </Border>
                        </Grid>

                        <!-- Horizontal grip: the whole top band's height (connection list AND 3D view
                             together) against the members table below. -->
                        <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch"
                                      Background="Transparent" ResizeDirection="Rows"
                                      Cursor="SizeNS"
                                      ToolTip="Drag to resize the connection list and the 3D view">
                            <GridSplitter.Template>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Grid Background="Transparent">
                                        <Border Width="36" Height="2" CornerRadius="1"
                                                Background="#C4CCD6" x:Name="Pill"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="#2E6FB0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>

                        <!-- Members of the selected connection -->
                        <!-- Row 2: whatever the grip leaves. No icon on the header - it is a peer of
                             the Connections table, whose heading is a plain TextBlock, and one of the
                             two carrying an icon made them read as different kinds of thing. -->
                        <Expander Grid.Row="2" IsExpanded="True" Margin="0,0,0,4" Background="Transparent">
                            <Expander.Header>
                                <TextBlock Text="Members" FontWeight="Medium"/>
                            </Expander.Header>
                            <!-- Grid, not StackPanel: a StackPanel gives its child its natural height,
                                 so the grid would size to its rows and scroll no matter how much room
                                 the expander had. -->
                            <Grid Margin="8,4,8,4">
                                <!-- No MaxHeight: a 140 px cap made this grid scroll while empty space
                                     sat below it. The expander fills its Grid row, so the table gets
                                     whatever the grip leaves it and the scrollbar appears only when the
                                     rows really do not fit. -->
                                <!-- Whole rows, one at a time: the 3D view selects a MEMBER, so a
                                     row is the unit that means anything here. IsReadOnly on the grid
                                     because every column is read from the model - see the D/t/f_y
                                     columns below. -->
                                <DataGrid x:Name="MembersGrid" AutoGenerateColumns="False"
                                          CanUserAddRows="False" IsReadOnly="True"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          md:DataGridAssist.CellPadding="6 3"
                                          GridLinesVisibility="Horizontal" BorderThickness="0"
                                          VerticalScrollBarVisibility="Auto"
                                          FontSize="12">
                                    <!-- hovering a row highlights that member in the 3D view -->
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                            <EventSetter Event="MouseEnter" Handler="MembersGrid_MemberHighlight"/>
                                            <EventSetter Event="MouseLeave" Handler="MembersGrid_ClearHighlight"/>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="SizeToHeader" MinWidth="55" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="SizeToHeader" MinWidth="50" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="*" MinWidth="90" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="SizeToHeader" MinWidth="60" IsReadOnly="True"/>
                                        <!-- Read-only, like every other column here. These three were
                                             editable from the days before the app could read them
                                             from the model and the user had to type them in. They now
                                             come from the connection itself - D/t from the IOM facet
                                             ring, f_y from the section's material - and
                                             EnrichSectionsFromIomAsync overwrites D and t on every
                                             run, so an edit looked accepted and was then silently
                                             discarded. -->
                                        <DataGridTextColumn Header="D [mm]" Binding="{Binding Diameter, StringFormat=F1}" Width="SizeToHeader" MinWidth="55" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="t [mm]" Binding="{Binding WallThickness, StringFormat=F1}" Width="SizeToHeader" MinWidth="50" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="f_y [MPa]" Binding="{Binding Fy, StringFormat=F0}" Width="SizeToHeader" MinWidth="60" IsReadOnly="True"
                                                            HeaderStyle="{StaticResource SubscriptColumnHeader}"/>
                                        <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="SizeToHeader" MinWidth="60" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Expander>
                    </Grid>

                </DockPanel>
            </TabItem>

            <!-- Tab 2: Results -->
            <!-- One tab per check family. Results below keeps everything, as the cross-cutting
                 summary of whatever the user ran; these two are the detail per family. A §6.3 tab
                 belongs here too, if that chapter is ever un-mothballed. -->
            <TabItem x:Name="Tab64" IsEnabled="False">
                <TabItem.Header>
                    <StackPanel>
                        <md:PackIcon Kind="VectorCircleVariant" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="§6.4" HorizontalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </TabItem.Header>
                <!-- Shaped after the python reference's results sheet (ui.html): a connection and
                     load-effect selector on top, the joint seen in its own plane beside the
                     per-brace check table, and a click into a row for the full derivation. -->
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── selector bar ── -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Connection:" VerticalAlignment="Center"
                                   Foreground="#546E7A" Margin="0,0,6,0"/>
                        <ComboBox Grid.Column="1" x:Name="Cmb64Connection" MinWidth="120"
                                  SelectionChanged="Joint64Selection_Changed" Margin="0,0,20,0"/>

                        <!-- per-LC vs envelope. The envelope is per BRACE: each brace reports the
                             state that governs IT, so different braces can name different states. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <RadioButton x:Name="Rb64Envelope" Content="Envelope" IsChecked="True"
                                         GroupName="Le64Mode" Margin="0,0,10,0"
                                         Checked="Joint64Selection_Changed"
                                         ToolTip="Per brace, the load effect with the highest utilisation"/>
                            <RadioButton x:Name="Rb64PerLe" Content="per LC" GroupName="Le64Mode"
                                         Checked="Joint64Selection_Changed"
                                         ToolTip="Show one selected load effect"/>
                        </StackPanel>

                        <TextBlock Grid.Column="3" x:Name="Lbl64Le" Text="Load effect:"
                                   VerticalAlignment="Center" Foreground="#546E7A" Margin="0,0,6,0"/>
                        <!-- The load-effect selector carries a utilisation bar per state, as the
                             python selector does: name, a bar as wide as the worst utilisation in
                             that state and coloured on the same four bands as the joint view, the
                             number, and ✗ when a brace fails there. It answers "which state should
                             I look at" without opening each one.

                             The bar is a two-column Grid whose star widths come from BarFraction
                             and its complement — a Width binding cannot be a percentage in WPF. -->
                        <ComboBox Grid.Column="4" x:Name="Cmb64Le" MinWidth="240"
                                  SelectionChanged="Joint64Selection_Changed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinWidth="220">
                                        <!-- the bar sits behind the text, at low opacity -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource FractionToStar}}"/>
                                                <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource FractionToRestStar}}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Opacity="0.30" CornerRadius="2"
                                                    Background="{Binding BarColour}"/>
                                        </Grid>
                                        <Grid Margin="4,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FailMark}"
                                                       Foreground="{StaticResource VerdictFailFg}"
                                                       FontWeight="Bold" Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UtilText}"
                                                       Margin="10,0,0,0" MinWidth="46"
                                                       TextAlignment="Right" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Column="5" x:Name="Lbl64Summary" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Foreground="#78909C" FontSize="11"/>
                    </Grid>

                    <!-- ── the joint's verdict, and every condition it did not meet ── -->
                    <Border Grid.Row="1" x:Name="Pnl64Verdict" Visibility="Collapsed"
                            Background="{StaticResource VerdictNaBg}" CornerRadius="4"
                            Padding="14,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="Lbl64VerdictTitle" FontWeight="Bold"
                                       Foreground="{StaticResource VerdictFailFg}" TextWrapping="Wrap"/>
                            <!-- HorizontalAlignment Left, not the StackPanel's default Stretch: with a
                                 MaxWidth the block is narrower than the panel, and a stretched child
                                 that cannot fill its space is CENTRED — so this paragraph sat indented
                                 while the title and the condition list above and below it started at
                                 the left edge. -->
                            <TextBlock x:Name="Lbl64VerdictBody" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="#455A64" MaxWidth="900"
                                       HorizontalAlignment="Left"/>
                            <ItemsControl x:Name="Lst64Conditions" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ── the results sheet, laid out as the python reference's: a top band with
                         the joint beside the per-LE force tables, and the classification + member
                         check table across the full width below it.

                         Two splitters, as python has: the horizontal grip trades the joint view
                         against the force tables, the vertical one trades the whole top band
                         against the table. Star heights so a grip moves space between them rather
                         than growing the tab. ── -->
                    <!-- x:Name so a rejected joint can hide the whole sheet: with §6.4 out of
                         scope there are no results, and showing a table of them next to a banner
                         that says nothing was assessed states both at once. -->
                    <Grid Grid.Row="2" x:Name="Pnl64Sheet">
                        <!-- 1:1, measured not guessed: in per-LC mode with 6 braces the right column
                             (node equilibrium + brace forces) needs 356 px, and 2* of 5* gave it
                             only 329 — a vertical scrollbar over the brace-force table. An even
                             split clears it and still leaves the classification table below more
                             than its 140 px floor. See LayoutMeasurementProbe. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" MinHeight="180"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*" MinHeight="140"/>
                        </Grid.RowDefinitions>

                        <!-- top band: joint | grip | per-LE force cards -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <!-- 600, measured not guessed: the brace-force table wants 969 px for
                                     its 11 columns with 6 braces in it (LayoutMeasurementProbe — the
                                     sum of their MinWidths is only 734, because SizeToHeader columns
                                     grow to their content). At the 1780 start-up width that leaves
                                     this much for the view, and the right column is no longer able to
                                     borrow width from outside the window now that its ScrollViewer
                                     has horizontal scrolling Disabled. -->
                                <ColumnDefinition Width="600" MinWidth="440"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="280"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="2">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" x:Name="Lbl64JointTitle"
                                               Margin="8,6,8,4" FontWeight="Medium" FontSize="12"/>
                                    <!-- utilisation colour key, as python's res-legend. Mouse
                                         interaction is deliberately off on this view (see
                                         Joint3DView.Interactive) so it behaves like python's 2D
                                         schematic: fixed 90-degree turns and a normal flip. -->
                                    <Grid DockPanel.Dock="Bottom" Margin="8,4,8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="utilisation:" Foreground="#78909C"
                                                       FontSize="10.5" VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="0" Foreground="#78909C" FontSize="10.5"
                                                       VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            <!-- Filled in code from UtilisationScale (see
                                                 BuildUtilisationLegend), not listed here: the swatches
                                                 ARE the scale, and a hand-written copy of it drifts
                                                 the moment a band changes. -->
                                            <StackPanel x:Name="Legend64Swatches" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="0,0,2,0"/>
                                            <TextBlock Text="1.0" Foreground="#78909C" FontSize="10.5"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Width="14" Height="9" Background="#9EAFB8" Margin="0,0,3,0"
                                                    BorderBrush="#7C8B93" BorderThickness="1"/>
                                            <TextBlock Text="chord" Foreground="#78909C" FontSize="10.5"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Width="14" Height="9" Background="#C4C4C4" Margin="0,0,3,0"
                                                    BorderBrush="#A8A8A8" BorderThickness="1"/>
                                            <TextBlock Text="no check" Foreground="#78909C" FontSize="10.5"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="Btn64RotL" Click="Joint64_RotateLeft"
                                                    Width="24" Height="22" Padding="0" Margin="0,0,3,0"
                                                    ToolTip="Turn the view 90° left">
                                                <md:PackIcon Kind="RotateLeft" Width="14" Height="14"/>
                                            </Button>
                                            <Button x:Name="Btn64RotR" Click="Joint64_RotateRight"
                                                    Width="24" Height="22" Padding="0" Margin="0,0,3,0"
                                                    ToolTip="Turn the view 90° right">
                                                <md:PackIcon Kind="RotateRight" Width="14" Height="14"/>
                                            </Button>
                                            <Button x:Name="Btn64Flip" Click="Joint64_FlipNormal"
                                                    Width="24" Height="22" Padding="0"
                                                    ToolTip="Look at the joint plane from the other side">
                                                <md:PackIcon Kind="FlipHorizontal" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <controls:Joint3DView x:Name="Joint3D64"/>
                                </DockPanel>
                            </Border>

                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="Transparent"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                          Cursor="SizeWE" ToolTip="Drag to resize the joint view">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Grid Background="Transparent">
                                            <Border Width="2" Height="36" CornerRadius="1"
                                                    Background="#C4CCD6" x:Name="Pill64"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Pill64" Property="Background" Value="#2E6FB0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>

                            <!-- right column: the two per-LE cards in per-LC mode, or the envelope
                                 note. Both are per-load-effect quantities, so an envelope has no
                                 single set of them to show — python hides them for the same reason. -->
                            <!-- Horizontal scrolling DISABLED, not Auto. On Auto this viewer hands its
                                 content unlimited width, so the envelope note's TextWrapping="Wrap"
                                 had nothing to wrap against and the whole column scrolled sideways
                                 instead (measured: 1039 px of content in a 908 px viewport). Disabled
                                 pins the content to the viewport, the note wraps, and the one child
                                 that really is wider than the column — the brace-force table — brings
                                 its own horizontal scrollbar. -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- envelope note -->
                                    <Border x:Name="Pnl64EnvNote" Background="#F7F9FB"
                                            BorderBrush="#E0E0E0" BorderThickness="1"
                                            CornerRadius="2" Padding="12,10" Margin="0,0,0,8"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Envelope" FontWeight="Medium" FontSize="12"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="#546E7A" FontSize="11.5"
                                                       Text="Each brace shows its governing load effect — the one with the highest utilisation. The node-equilibrium and in-plane brace-force tables are per load effect, so switch to &quot;per LC&quot; to inspect a single one."/>
                                        </StackPanel>
                                    </Border>

                                    <!-- node equilibrium (self-check) -->
                                    <Border x:Name="Pnl64Equilibrium" BorderBrush="#E0E0E0"
                                            BorderThickness="1" CornerRadius="2" Padding="10,8"
                                            Margin="0,0,0,8" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Node equilibrium (self-check)" FontWeight="Medium"
                                                       FontSize="12" Margin="0,0,0,6"/>
                                            <!-- Sorting OFF: two fixed rows (ΣF then ΣM), and the
                                                 ItemsSource is a plain List so it never sorted. -->
                                            <DataGrid x:Name="Grid64Equilibrium" AutoGenerateColumns="False"
                                                      IsReadOnly="True" CanUserAddRows="False"
                                                      CanUserSortColumns="False"
                                                      HeadersVisibility="Column" GridLinesVisibility="All"
                                                      VerticalGridLinesBrush="#DCE3E8"
                                                      HorizontalGridLinesBrush="#ECF0F3"
                                                      BorderThickness="0" FontSize="11.5"
                                                      md:DataGridAssist.CellPadding="8 3">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="quantity" Binding="{Binding Quantity}" Width="SizeToCells" MinWidth="80"/>
                                                    <DataGridTextColumn Header="X" Binding="{Binding X}" Width="*" MinWidth="60"/>
                                                    <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="*" MinWidth="60"/>
                                                    <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="*" MinWidth="60"/>
                                                    <DataGridTextColumn Header="state" Binding="{Binding State}" Width="SizeToHeader" MinWidth="44"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#78909C"
                                                       FontSize="10.5"
                                                       Text="Residual force and moment at the node, summed over every member. Small values are normal (the stored input is rounded); a large residual means the loads are not in balance."/>
                                        </StackPanel>
                                    </Border>

                                    <!-- brace forces resolved into the joint plane -->
                                    <Border x:Name="Pnl64BraceForces" BorderBrush="#E0E0E0"
                                            BorderThickness="1" CornerRadius="2" Padding="10,8"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Brace forces in joint plane" FontWeight="Medium"
                                                       FontSize="12" Margin="0,0,0,6"/>
                                            <!-- Sorting OFF: the row order is the joint's member order,
                                                 which is how this table is read against the 3D view
                                                 and the classification table below. Never sorted
                                                 anyway — the ItemsSource is a plain List. -->
                                            <DataGrid x:Name="Grid64BraceForces" AutoGenerateColumns="False"
                                                      IsReadOnly="True" CanUserAddRows="False"
                                                      CanUserSortColumns="False"
                                                      HeadersVisibility="Column" GridLinesVisibility="All"
                                                      VerticalGridLinesBrush="#DCE3E8"
                                                      HorizontalGridLinesBrush="#ECF0F3"
                                                      BorderThickness="0" FontSize="11.5"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      md:DataGridAssist.CellPadding="7 3">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="brace" Binding="{Binding Brace}" Width="SizeToHeader" MinWidth="46"/>
                                                    <!-- N, not N_Sd: in THIS table the axial force is a COMPONENT of the
                                                         frame, sibling to V_y and V_z. The Sd subscript marks a design
                                                         action effect weighed against a resistance — eq (6.57) and the
                                                         classification table — not a resolved component. -->
                                                    <DataGridTextColumn Header="N [kN]" Binding="{Binding NSd}" Width="SizeToHeader" MinWidth="62"
                                                                        HeaderStyle="{StaticResource SubscriptColumnHeader}"/>
                                                    <!-- The brace frame (x,y,z) = (brace axis, plane NORMAL, IN the plane),
                                                         right-handed — see JointForceResolver.BraceForceInPlane.
                                                         A MOMENT's index is its axis of ROTATION, a FORCE's index its
                                                         direction of ACTION, so M_y bends in the plane (about the normal)
                                                         while V_z acts in it. That is why V_z binds to Vip and V_y to Vop:
                                                         the property names are the engine's ip/op, the headers are the
                                                         frame's axes. The ,chord index marks the chord's own moments —
                                                         same plane, but not terms of eq (6.57). -->
                                                    <DataGridTextColumn Header="M_y [kNm]" Binding="{Binding Mip}" Width="SizeToHeader" MinWidth="66"
                                                                        HeaderStyle="{StaticResource SubscriptColumnHeader}"/>
                                                    <DataGridTextColumn Header="M_z [kNm]" Binding="{Binding Mop}" Width="SizeToHeader" MinWidth="66"
                                                                        HeaderStyle="{StaticResource SubscriptColumnHeader}"/>
                                                    <DataGridTextColumn Header="V_y [kN]" Binding="{Binding Vop}" Width="SizeToHeader" MinWidth="60"
                                                                        HeaderStyle="{StaticResource SubscriptColumnHeader}"/>
                                                    <DataGridTextColumn Header="V_z [kN]" Binding="{Binding Vip}" Width="SizeToHeader" MinWidth="60"
                                                                        HeaderStyle="{StaticResource SubscriptColumnHeader}"/>
                                                    <DataGridTextColumn Header="M_tor [kNm]" Binding="{Binding Mtor}" Width="SizeToHeader" MinWidth="68"
                                                                        HeaderStyle="{StaticResource SubscriptColumnHeader}"/>
                                                    <DataGridTextColumn Header="face" Binding="{Binding Face}" Width="SizeToHeader" MinWidth="58"/>
                                                    <DataGridTextColumn Header="N_chord [kN]" Binding="{Binding NChord}" Width="SizeToHeader" MinWidth="72"
                                                                        HeaderStyle="{StaticResource SubscriptColumnHeader}"/>
                                                    <DataGridTextColumn Header="M_y,chord [kNm]" Binding="{Binding MipChord}" Width="SizeToHeader" MinWidth="88"
                                                                        HeaderStyle="{StaticResource SubscriptColumnHeader}"/>
                                                    <DataGridTextColumn Header="M_z,chord [kNm]" Binding="{Binding MopChord}" Width="SizeToHeader" MinWidth="88"
                                                                        HeaderStyle="{StaticResource SubscriptColumnHeader}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#78909C"
                                                       FontSize="10.5"
                                                       Text="Brace forces in a right-handed frame per brace: x along the brace away from the node (so +N is tension), y the joint plane's normal, z in the plane. A moment's index is its axis of rotation, a force's index its direction of action — so M_y bends within the plane and V_z acts in it. Only N, M_y and M_z enter the check (eq. 6.57, where they appear as N_Sd, M_y,Sd and M_z,Sd); M_tor and the shears are reported, not assessed. The last three columns are the chord's own internal forces at that brace's footprint — the raw input to the chord stress."/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- vertical grip: the whole top band vs the classification table below -->
                        <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" Background="Transparent"
                                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                                      Cursor="SizeNS" ToolTip="Drag to resize the joint view">
                            <GridSplitter.Template>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Grid Background="Transparent">
                                        <Border Width="36" Height="2" CornerRadius="1"
                                                Background="#C4CCD6" x:Name="Pill64V"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill64V" Property="Background" Value="#2E6FB0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>

                        <DockPanel Grid.Row="2" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6"
                                       Text="Classification &amp; member checks — NORSOK Standard N-004"
                                       FontWeight="Medium" FontSize="12"/>
                            <!-- The group banner: one merged cell per group of columns, each centred
                                 over the columns it spans, as the python table's colspan header row
                                 is. Its cells are sized in code from the grid's actual column widths
                                 (SyncGroup64Band) because those widths are SizeToHeader and change
                                 with the content — a fixed set of widths here would drift out of
                                 alignment the first time a number grew a digit.
                                 Horizontally offset by the grid's own scroll position so the banner
                                 tracks the columns when the table is scrolled sideways. -->
                            <Canvas DockPanel.Dock="Top" x:Name="Group64Band" Height="19"
                                    ClipToBounds="True" Background="#F4F7F9"/>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="Lbl64Legend" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Foreground="#78909C" FontSize="11"/>
                            <!-- Sorting OFF. The rows are not a flat list: every "K via <partner>"
                                 sub-row is a breakdown of the brace row directly above it, and any
                                 reordering separates the two and silently attaches the sub-row to a
                                 different brace. It also never worked — the ItemsSource is a plain
                                 List, so the header showed a sort arrow and reordered nothing. -->
                            <DataGrid x:Name="Grid64" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      CanUserSortColumns="False"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      md:DataGridAssist.CellPadding="8 5"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      GridLinesVisibility="All"
                                                      VerticalGridLinesBrush="#DCE3E8"
                                                      HorizontalGridLinesBrush="#ECF0F3" BorderThickness="0"
                                      FontSize="12"
                                      MouseDoubleClick="Grid64_ShowDerivation">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                        <Setter Property="ToolTip" Value="Double-click for the full derivation"/>
                                        <!-- No MouseEnter highlight here: the bodies carry their
                                             member names now, so pointing at a row to find out
                                             which body it is has nothing left to add, and the
                                             colour it painted overwrote the utilisation colour the
                                             view exists to show. -->

                                        <!-- Coloured by UTILISATION, not by verdict. The verdict only
                                             says whether the row crossed 100 %, so a brace at 7 % and
                                             one at 99 % were the same green — the very comparison this
                                             table exists to support. The tint is a pale form of the
                                             ten-band scale shared with the 3D view, the load-effect
                                             bar and the legend, so one utilisation is one colour
                                             everywhere. FAIL still reads red: the top band IS red. -->
                                        <Setter Property="Background"
                                                Value="{Binding RowTint, Converter={StaticResource ColorToBrush}}"/>

                                        <Style.Triggers>
                                            <!-- N/A keeps its own flat colour: there is no number, so
                                                 there is no band, and an untinted row would read as
                                                 0 % rather than as "not assessed". -->
                                            <DataTrigger Binding="{Binding Verdict}" Value="N/A">
                                                <Setter Property="Background" Value="{StaticResource VerdictNaBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource VerdictNaFg}"/>
                                            </DataTrigger>
                                            <!-- LAST, so it wins over the verdict colours: a K
                                                 sub-row carries no verdict of its own and must not
                                                 borrow the colour of the brace above it. Its own
                                                 tooltip too — it cannot be double-clicked. -->
                                            <DataTrigger Binding="{Binding IsSubRow}" Value="True">
                                                <Setter Property="Background" Value="#F7F9FB"/>
                                                <Setter Property="Foreground" Value="#78909C"/>
                                                <Setter Property="ToolTip" Value="One K component of the brace above"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- name + the design actions beneath it, as python's table has:
                                         a template column because two lines cannot come from a text
                                         column, and the actions are what the row was checked FOR. -->
                                    <DataGridTemplateColumn Header="Brace" Width="SizeToCells" MinWidth="130"
                                                            SortMemberPath="Brace">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Brace}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Actions}" FontSize="10"
                                                               Foreground="#78909C" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="Col64Gov" Header="Governing LC" Binding="{Binding GoverningLe}" Width="SizeToCells" MinWidth="90"/>
                                    <!-- Two-line headers carrying the python table's column GROUPS:
                                         "Classification" over K/X/Y, "Resistance" over the three
                                         N_Rd/M_Rd, "Utilisation breakdown" over the three shares,
                                         "Check" over the total and the verdict. WPF's DataGrid has
                                         no column-group concept, so the group name is the first
                                         line of the FIRST column's header in each group and the
                                         others carry a blank line to keep the two rows aligned.
                                         Without this the eleven middle columns read as one flat
                                         run, and "axial" next to "N_Rd" gives no clue that one is
                                         a share of the utilisation and the other a resistance. -->
                                    <DataGridTextColumn Binding="{Binding FrK}" Width="SizeToHeader" MinWidth="50"
                                                        HeaderStyle="{StaticResource Grouped64HeaderStart}"
                                                        CellStyle="{StaticResource Group64CellStart}"
                                                        Header="K"/>
                                    <DataGridTextColumn Binding="{Binding FrX}" Width="SizeToHeader" MinWidth="50"
                                                        HeaderStyle="{StaticResource Grouped64Header}"
                                                        Header="X"/>
                                    <DataGridTextColumn Binding="{Binding FrY}" Width="SizeToHeader" MinWidth="50"
                                                        HeaderStyle="{StaticResource Grouped64Header}"
                                                        Header="Y"/>
                                    <DataGridTextColumn Binding="{Binding NRd}" Width="SizeToHeader" MinWidth="70"
                                                        HeaderStyle="{StaticResource Grouped64HeaderStart}"
                                                        CellStyle="{StaticResource Group64CellStart}"
                                                        Header="N_Rd"/>
                                    <DataGridTextColumn Binding="{Binding MRdIp}" Width="SizeToHeader" MinWidth="70"
                                                        HeaderStyle="{StaticResource Grouped64Header}"
                                                        Header="M_y,Rd"/>
                                    <DataGridTextColumn Binding="{Binding MRdOp}" Width="SizeToHeader" MinWidth="70"
                                                        HeaderStyle="{StaticResource Grouped64Header}"
                                                        Header="M_z,Rd"/>
                                    <DataGridTextColumn Binding="{Binding UtilAxial}" Width="SizeToHeader" MinWidth="55"
                                                        HeaderStyle="{StaticResource Grouped64HeaderStart}"
                                                        CellStyle="{StaticResource Group64CellStart}"
                                                        Header="axial"/>
                                    <DataGridTextColumn Binding="{Binding UtilIpb}" Width="SizeToHeader" MinWidth="55"
                                                        HeaderStyle="{StaticResource Grouped64Header}"
                                                        Header="in-plane"/>
                                    <DataGridTextColumn Binding="{Binding UtilOpb}" Width="SizeToHeader" MinWidth="55"
                                                        HeaderStyle="{StaticResource Grouped64Header}"
                                                        Header="out-of-plane"/>
                                    <DataGridTextColumn Binding="{Binding Util}" Width="SizeToHeader" MinWidth="80"
                                                        HeaderStyle="{StaticResource Grouped64HeaderStart}"
                                                        CellStyle="{StaticResource Group64CellStart}"
                                                        Header="utilisation"/>
                                    <DataGridTextColumn Header="" Binding="{Binding Flags}" Width="SizeToCells" MinWidth="24"/>
                                    <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="SizeToHeader" MinWidth="60"/>
                                    <!-- One column for both, because they are the same question
                                         answered in two ways: on a brace row, why nothing could be
                                         checked (or how the classifier reached its split); on a K
                                         sub-row, the force and the gap behind that fraction. -->
                                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}"
                                                        Width="*" MinWidth="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="FontSize" Value="11"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabResults" IsEnabled="False">
                <TabItem.Header>
                    <StackPanel>
                        <md:PackIcon Kind="TableLarge" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Results" HorizontalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- No export button here: the PDF is the Report tab's output, and offering it
                         from the overview invited a click that leaves the tab you are reading. -->
                    <TextBlock Grid.Row="0" Margin="0,0,0,12"
                               Text="Every check performed, across all chapters and connections. The per-chapter tabs show the same results grouped."
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Foreground="#546E7A"/>

                    <DataGrid Grid.Row="1" x:Name="ResultsGrid" AutoGenerateColumns="True"
                              IsReadOnly="True" CanUserAddRows="False"
                              CanUserSortColumns="False"
                              md:DataGridAssist.CellPadding="10 6"
                              VerticalScrollBarVisibility="Auto"
                              GridLinesVisibility="All"
                              VerticalGridLinesBrush="#DCE3E8"
                              HorizontalGridLinesBrush="#ECF0F3"
                              BorderThickness="0"/>
                </Grid>
            </TabItem>

            <!-- Tab 3: Report -->
            <TabItem x:Name="TabReport" IsEnabled="False">
                <TabItem.Header>
                    <StackPanel>
                        <md:PackIcon Kind="FileDocumentOutline" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Report" HorizontalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Export belongs here, beside the document it writes: the button used to sit on
                         the Results tab, where clicking it produced a file of something the reader
                         was not looking at.

                         Page setup is a BUTTON rather than a dialog on the way out, so exporting
                         stays one click. Setup first, export last — the order they are used in. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="8,4,8,8">
                        <!-- IdeaOutlineButton, matching the Run bar's pairing (Cancel beside Run
                             Norsok Check): one primary action in orange with its secondary in the
                             orange outline. This was the only text button on an action bar in the
                             window with NO style, so it rendered in default WPF chrome next to an
                             orange Export and the two did not read as a pair.
                             No inline Padding: the style's 12,4 must govern, or the two buttons
                             still differ in height and the mismatch only moves. -->
                        <Button x:Name="BtnPageSetup" Click="PageSetup_Click"
                                Style="{StaticResource IdeaOutlineButton}"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="PageLayoutBody" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Page setup" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnExportPdf" Click="ExportPdf_Click"
                                Style="{StaticResource IdeaPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Export PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- DefaultBackgroundColor, because an un-navigated WebView2 paints BLACK. That
                         is the colour of a failure, so the report looked broken whenever it was
                         merely not ready yet — and it cost three wrong diagnoses before the cause
                         was measured. White says "nothing here yet"; the overlay below says why. -->
                    <wv2:WebView2 Grid.Row="1" x:Name="ReportWebView" DefaultBackgroundColor="White" />

                    <!-- Sits OVER the WebView2 while the report is being built. The work is ~22 s on
                         a fifteen-joint project (measured per connection in FigureLiveProbe), and
                         the tab is reachable throughout — with no overlay the user stares at an
                         empty view with nothing to say the app is working. -->
                    <Border Grid.Row="1" x:Name="ReportBusy" Visibility="Collapsed"
                            Background="#F7F9FB">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Generating the report…" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#33475B" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ReportBusyDetail" FontSize="12" Foreground="#6B7C93"
                                       Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══ Status bar ═══ -->
        <Border Grid.Row="3" Margin="16,0,16,4" Padding="8,4"
                Background="#FFF8E1" CornerRadius="4"
                Visibility="Collapsed" x:Name="StatusBar">
            <Border.Resources>
                <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="SpinnerIcon"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     From="0" To="360" Duration="0:0:1"/>
                </Storyboard>
            </Border.Resources>
            <StackPanel Orientation="Horizontal">
                <md:PackIcon x:Name="SpinnerIcon" Kind="Loading" Width="16" Height="16"
                             Foreground="#F57C00" VerticalAlignment="Center" Margin="0,0,8,0"
                             RenderTransformOrigin="0.5,0.5">
                    <md:PackIcon.RenderTransform>
                        <RotateTransform/>
                    </md:PackIcon.RenderTransform>
                </md:PackIcon>
                <TextBlock x:Name="StatusText" Text="Calculating..." Foreground="#F57C00"
                           FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ Log panel — only shown on the Check tab ═══ -->
        <md:Card x:Name="LogCard" Grid.Row="4" Margin="16,0,16,12" Padding="0" md:ElevationAssist.Elevation="Dp1">
            <!-- Collapsed by default: the log is diagnostics, and expanded it takes height from the
                 tables that carry the actual result. -->
            <Expander x:Name="LogExpander" IsExpanded="False" md:ExpanderAssist.HorizontalHeaderPadding="16"
                      Background="Transparent">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Console" Width="16" Height="16" VerticalAlignment="Center"
                                     Foreground="#78909C" Margin="0,0,8,0"/>
                        <TextBlock Text="Log" Foreground="#78909C"/>
                    </StackPanel>
                </Expander.Header>
                <TextBox x:Name="LogBox" Height="110" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5"
                         Margin="12,0,12,8" Background="#FAFBFC"
                         BorderThickness="0" Foreground="#455A64"/>
            </Expander>
        </md:Card>
    </Grid>
</Window>
