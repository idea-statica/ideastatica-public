<Window x:Class="NorsokChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:NorsokChecker.Controls"
        Title="IDEA StatiCa — NORSOK N-004 Connection Checker"
        Width="1100" Height="780"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- IDEA StatiCa brand -->
        <Color x:Key="IdeaOrange">#F57C00</Color>
        <Color x:Key="IdeaDark">#2D2D2D</Color>
        <SolidColorBrush x:Key="IdeaOrangeBrush" Color="{StaticResource IdeaOrange}"/>
        <SolidColorBrush x:Key="IdeaDarkBrush" Color="{StaticResource IdeaDark}"/>
        <!-- Norsok accent -->
        <Color x:Key="NorsokTeal">#00838F</Color>
        <Color x:Key="NorsokTealLight">#4FB3BF</Color>
        <SolidColorBrush x:Key="NorsokTealBrush" Color="{StaticResource NorsokTeal}"/>

        <!-- Verdict colours. Defined once here because the same four states appear in the
             connection list and in the per-check tables, and they were drifting apart.

             Three degrees, not two, and the middle one is NOT a fail:
               FAIL     red    - checked, and it does not comply
               PASS     green  - checked, and it complies
               PARTIAL  amber  - everything checked passed, but part was not assessed
               N/A      grey   - NOTHING was checked; no verdict was ever reached
             N/A and PARTIAL used to share the same amber, so "outside the scope of 6.4"
             was indistinguishable from "checked, with a gap". Grey says "no answer here",
             which is what N/A is. The amber foreground also sat next to the IDEA brand
             orange, so it read as an accent rather than a caution - hence the darker
             amber text below. -->
        <SolidColorBrush x:Key="VerdictFailBg"     Color="#FFEBEE"/>
        <SolidColorBrush x:Key="VerdictFailFg"     Color="#C62828"/>
        <SolidColorBrush x:Key="VerdictPassBg"     Color="#E8F5E9"/>
        <SolidColorBrush x:Key="VerdictPassFg"     Color="#1B5E20"/>
        <SolidColorBrush x:Key="VerdictPartialBg"  Color="#FFF8E1"/>
        <SolidColorBrush x:Key="VerdictPartialFg"  Color="#8D6E00"/>
        <SolidColorBrush x:Key="VerdictNaBg"       Color="#EEEEEE"/>
        <SolidColorBrush x:Key="VerdictNaFg"       Color="#546E7A"/>

        <!-- Button styles -->
        <Style x:Key="IdeaPrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="{StaticResource IdeaOrangeBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="md:ElevationAssist.Elevation" Value="Dp2"/>
        </Style>
        <Style x:Key="IdeaOutlineButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="BorderBrush" Value="{StaticResource IdeaOrangeBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource IdeaOrangeBrush}"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header — IDEA StatiCa primary with orange accent ═══ -->
        <Border Grid.Row="0" md:ElevationAssist.Elevation="Dp4">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource IdeaDark}"/>
            </Border.Background>
            <Grid Margin="20,12,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: IDEA StatiCa brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Orange bar accent (like IDEA logo) -->
                    <Border Width="4" Height="32" Background="{StaticResource IdeaOrangeBrush}"
                            CornerRadius="2" Margin="0,0,12,0"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IDEA" FontSize="19" FontWeight="Bold" Foreground="#F57C00"/>
                            <TextBlock Text=" StatiCa" FontSize="19" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Connection API" FontSize="10" Foreground="#9E9E9E"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: divider + Norsok feature badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Border Background="#3E3E3E" Width="1" Height="28" Margin="20,0,20,0"/>
                    <Grid Width="28" Height="28" Margin="0,0,10,0">
                        <Ellipse Fill="#00838F" Opacity="0.2"/>
                        <md:PackIcon Kind="ShieldCheck" Width="16" Height="16"
                                     Foreground="#4FB3BF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="NORSOK N-004" FontSize="14" FontWeight="SemiBold" Foreground="#4FB3BF"/>
                        <TextBlock Text="Connection Compliance Checker" FontSize="10" Foreground="#78909C"
                                   Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: version -->
                <TextBlock Grid.Column="2" Text="v0.2" FontSize="10" Foreground="#616161"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ Configuration Card — only shown on the Check tab ═══ -->
        <md:Card x:Name="ConfigCard" Grid.Row="1" Margin="16,12,16,4" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Expander IsExpanded="True" md:ExpanderAssist.HorizontalHeaderPadding="16"
                      Background="Transparent">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Cog" Width="18" Height="18" VerticalAlignment="Center"
                                     Foreground="{StaticResource IdeaOrangeBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="API Configuration" FontWeight="Medium"/>
                    </StackPanel>
                </Expander.Header>
                <Grid Margin="16,4,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="RbSpawn" Content="Spawn local API" IsChecked="True"
                                     Checked="ServiceMode_Changed"
                                     Margin="0,0,24,0" Style="{StaticResource MaterialDesignRadioButton}"/>
                        <RadioButton x:Name="RbAttach" Content="Attach to running service"
                                     Checked="ServiceMode_Changed"
                                     Style="{StaticResource MaterialDesignRadioButton}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LblApiPath" Text="IDEA StatiCa folder:"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtApiPath"
                             Text="C:\Program Files\IDEA StatiCa\StatiCa 26.0"
                             md:HintAssist.Hint="Path to installation or service URL"
                             Margin="0,0,8,0"/>
                    <Button Grid.Row="1" Grid.Column="2" x:Name="BtnBrowseApiPath" Content="Browse..."
                            Click="BrowseApiPath_Click"
                            Style="{StaticResource IdeaOutlineButton}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Project file (.ideaCon):"
                               VerticalAlignment="Center" Margin="0,8,12,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtProjectFile"
                             md:HintAssist.Hint="Select an .ideaCon project file"
                             Margin="0,8,8,0"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Click="BrowseProject_Click"
                            Style="{StaticResource IdeaOutlineButton}" Margin="0,8,0,0"/>
                </Grid>
            </Expander>
        </md:Card>

        <!-- ═══ Main workspace ═══ -->
        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="16,8,16,8"
                    SelectionChanged="MainTabs_SelectionChanged"
                    Style="{StaticResource MaterialDesignNavigationRailTabControl}">

            <!-- Tab 1: Check -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel>
                        <md:PackIcon Kind="ShieldCheck" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Check" HorizontalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Margin="12" LastChildFill="True">

                    <!-- Action bar — chapter toggles left, buttons right -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Chapters:" FontWeight="Medium" VerticalAlignment="Center"
                                       Foreground="#546E7A" Margin="0,0,10,0"/>
                            <CheckBox x:Name="ChkChapterCbfem" Content="CBFEM plates/welds" IsChecked="True" Margin="0,0,12,0"/>
                            <CheckBox x:Name="ChkChapter64" Content="§6.4 Joints" IsChecked="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnLoadProject" Click="LoadProject_Click"
                                    Style="{StaticResource IdeaOutlineButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="FolderOpen" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Load Project" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnRunCheck" IsEnabled="False" Click="RunCheck_Click"
                                    Style="{StaticResource IdeaPrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="PlayCircleOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Run Norsok Check" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Connections first (the connection is what everything below is about, with
                         the 3D view of the selected one beside it), then the members table.

                         A Grid with GridSplitters rather than a DockPanel: the useful split depends
                         on the project - how many connections, how big the joint - so it is the
                         user's to set, and a splitter needs real rows/columns to resize. Row 0 is
                         the connection+3D band, row 1 the grip, row 2 the members table.
                         Star heights on both content rows: the grip then trades one against the
                         other instead of either growing the tab. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*" MinHeight="80"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,2" x:Name="TopBand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="260"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="440" MinWidth="220"/>
                            </Grid.ColumnDefinitions>
                            <!-- Same size and indent as the Members heading below, and no icon on
                                 either - the two tables are peers, so their headings must read alike. -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Connections" FontWeight="Medium"
                                       Margin="16,0,0,4" VerticalAlignment="Center"/>
                            <!-- Connections grid — takes the width the 3D view does not. Its own
                                 scrollbar appears when the splitter squeezes it (VerticalScrollBar-
                                 Visibility="Auto" below), which is the point of giving it a MinHeight
                                 rather than letting it push the layout. -->
                            <DataGrid Grid.Row="1" Grid.Column="0" x:Name="ConnectionsGrid" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      SelectionChanged="ConnectionsGrid_SelectionChanged"
                                      md:DataGridAssist.CellPadding="10 6"
                                      VerticalScrollBarVisibility="Auto"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NorsokPass}" Value="FAIL">
                                                <Setter Property="Background" Value="{StaticResource VerdictFailBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource VerdictFailFg}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NorsokPass}" Value="PASS">
                                                <Setter Property="Background" Value="{StaticResource VerdictPassBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource VerdictPassFg}"/>
                                            </DataTrigger>
                                            <!-- grey, NOT amber: no verdict was reached, so this is neither
                                                 a pass nor a milder fail. It used to share PARTIAL's amber. -->
                                            <DataTrigger Binding="{Binding NorsokPass}" Value="N/A">
                                                <Setter Property="Background" Value="{StaticResource VerdictNaBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource VerdictNaFg}"/>
                                            </DataTrigger>
                                            <!-- amber: everything CHECKED passed, but part of the joint was
                                                 not assessed. Verified against the verdict logic - PARTIAL is
                                                 only reached when anyFailed is false, so it is a qualified
                                                 pass, not a fail. It keeps amber; only N/A moved to grey. -->
                                            <DataTrigger Binding="{Binding NorsokPass}" Value="PARTIAL">
                                                <Setter Property="Background" Value="{StaticResource VerdictPartialBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource VerdictPartialFg}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Connection" Binding="{Binding Name}" Width="*"/>
                                    <!-- SizeToCells: the longest status is "Outside §6.4 scope (7 conditions)",
                                         which a fixed 130 px truncated -->
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}"
                                                        Width="SizeToCells" MinWidth="130"/>
                                    <DataGridTextColumn Header="Max Utilization" Binding="{Binding MaxUtilizationDisplay}" Width="130"/>
                                    <DataGridTextColumn Header="Norsok" Binding="{Binding NorsokPass}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Vertical grip: 3D view width vs connection list width. Spans both rows
                                 so it can be grabbed level with the headings too. -->
                            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                          Width="8" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="Transparent"
                                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                                          Cursor="SizeWE"
                                          ToolTip="Drag to resize the 3D view">
                                <GridSplitter.Template>
                                    <ControlTemplate TargetType="GridSplitter">
                                        <Grid Background="Transparent">
                                            <Border Width="2" Height="36" CornerRadius="1"
                                                    Background="#C4CCD6" x:Name="Pill"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Pill" Property="Background" Value="#2E6FB0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>
                            <!-- No MinHeight here: the 3D view follows the band's height, which the
                                 horizontal splitter drives. A MinHeight would fight the splitter and
                                 stop the band from shrinking. RowSpan 2 so it is as tall as the
                                 heading plus the list beside it. -->
                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                    BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="2">
                                <controls:Joint3DView x:Name="Joint3D"/>
                            </Border>
                        </Grid>

                        <!-- Horizontal grip: the whole top band's height (connection list AND 3D view
                             together) against the members table below. -->
                        <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch"
                                      Background="Transparent" ResizeDirection="Rows"
                                      Cursor="SizeNS"
                                      ToolTip="Drag to resize the connection list and the 3D view">
                            <GridSplitter.Template>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Grid Background="Transparent">
                                        <Border Width="36" Height="2" CornerRadius="1"
                                                Background="#C4CCD6" x:Name="Pill"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="#2E6FB0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>

                        <!-- Members of the selected connection -->
                        <!-- Row 2: whatever the grip leaves. No icon on the header - it is a peer of
                             the Connections table, whose heading is a plain TextBlock, and one of the
                             two carrying an icon made them read as different kinds of thing. -->
                        <Expander Grid.Row="2" IsExpanded="True" Margin="0,0,0,4" Background="Transparent">
                            <Expander.Header>
                                <TextBlock Text="Members" FontWeight="Medium"/>
                            </Expander.Header>
                            <!-- Grid, not StackPanel: a StackPanel gives its child its natural height,
                                 so the grid would size to its rows and scroll no matter how much room
                                 the expander had. -->
                            <Grid Margin="8,4,8,4">
                                <!-- No MaxHeight: a 140 px cap made this grid scroll while empty space
                                     sat below it. The expander fills its Grid row, so the table gets
                                     whatever the grip leaves it and the scrollbar appears only when the
                                     rows really do not fit. -->
                                <DataGrid x:Name="MembersGrid" AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          md:DataGridAssist.CellPadding="6 3"
                                          GridLinesVisibility="Horizontal" BorderThickness="0"
                                          VerticalScrollBarVisibility="Auto"
                                          FontSize="12">
                                    <!-- hovering a row highlights that member in the 3D view -->
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                            <EventSetter Event="MouseEnter" Handler="MembersGrid_MemberHighlight"/>
                                            <EventSetter Event="MouseLeave" Handler="MembersGrid_ClearHighlight"/>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Member" Binding="{Binding Name}" Width="SizeToHeader" MinWidth="55" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="SizeToHeader" MinWidth="50" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="*" MinWidth="90" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="SizeToHeader" MinWidth="60" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="D [mm]" Binding="{Binding Diameter, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" Width="SizeToHeader" MinWidth="55"/>
                                        <DataGridTextColumn Header="t [mm]" Binding="{Binding WallThickness, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1}" Width="SizeToHeader" MinWidth="50"/>
                                        <DataGridTextColumn Header="f_y [MPa]" Binding="{Binding Fy, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}" Width="SizeToHeader" MinWidth="60"/>
                                        <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="SizeToHeader" MinWidth="60" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Expander>
                    </Grid>

                </DockPanel>
            </TabItem>

            <!-- Tab 2: Results -->
            <!-- One tab per check family. Results below keeps everything, as the cross-cutting
                 summary of whatever the user ran; these two are the detail per family. A §6.3 tab
                 belongs here too, if that chapter is ever un-mothballed. -->
            <TabItem x:Name="Tab64" IsEnabled="False">
                <TabItem.Header>
                    <StackPanel>
                        <md:PackIcon Kind="VectorCircleVariant" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="§6.4" HorizontalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,10"
                               Text="NORSOK N-004 §6.4 tubular joints — one row per brace, with the load effect that governs it. Conditions not met and assumptions made are listed first."
                               TextWrapping="Wrap"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Foreground="#546E7A"/>
                    <DataGrid Grid.Row="1" x:Name="Grid64" AutoGenerateColumns="True"
                              IsReadOnly="True" CanUserAddRows="False"
                              md:DataGridAssist.CellPadding="10 6"
                              VerticalScrollBarVisibility="Auto"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabCbfem" IsEnabled="False">
                <TabItem.Header>
                    <StackPanel>
                        <md:PackIcon Kind="ViewGridPlus" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="CBFEM" HorizontalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,10"
                               Text="CBFEM plate, weld and bolt checks from the calculation — Norsok material factors per Table 6-1."
                               TextWrapping="Wrap"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Foreground="#546E7A"/>
                    <DataGrid Grid.Row="1" x:Name="GridCbfem" AutoGenerateColumns="True"
                              IsReadOnly="True" CanUserAddRows="False"
                              md:DataGridAssist.CellPadding="10 6"
                              VerticalScrollBarVisibility="Auto"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabResults" IsEnabled="False">
                <TabItem.Header>
                    <StackPanel>
                        <md:PackIcon Kind="TableLarge" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Results" HorizontalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Every check performed, across all chapters and connections. The per-chapter tabs show the same results grouped."
                                   Style="{StaticResource MaterialDesignBody1TextBlock}"
                                   Foreground="#546E7A" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="BtnExportPdf" Click="ExportPdf_Click"
                                Style="{StaticResource IdeaPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Export PDF Reports" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="ResultsGrid" AutoGenerateColumns="True"
                              IsReadOnly="True" CanUserAddRows="False"
                              md:DataGridAssist.CellPadding="10 6"
                              VerticalScrollBarVisibility="Auto"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"/>
                </Grid>
            </TabItem>

            <!-- Tab 3: Report -->
            <TabItem x:Name="TabReport" IsEnabled="False">
                <TabItem.Header>
                    <StackPanel>
                        <md:PackIcon Kind="FileDocumentOutline" Width="24" Height="24" HorizontalAlignment="Center"/>
                        <TextBlock Text="Report" HorizontalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="4">
                    <wv2:WebView2 x:Name="ReportWebView" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══ Status bar ═══ -->
        <Border Grid.Row="3" Margin="16,0,16,4" Padding="8,4"
                Background="#FFF8E1" CornerRadius="4"
                Visibility="Collapsed" x:Name="StatusBar">
            <Border.Resources>
                <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="SpinnerIcon"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                     From="0" To="360" Duration="0:0:1"/>
                </Storyboard>
            </Border.Resources>
            <StackPanel Orientation="Horizontal">
                <md:PackIcon x:Name="SpinnerIcon" Kind="Loading" Width="16" Height="16"
                             Foreground="#F57C00" VerticalAlignment="Center" Margin="0,0,8,0"
                             RenderTransformOrigin="0.5,0.5">
                    <md:PackIcon.RenderTransform>
                        <RotateTransform/>
                    </md:PackIcon.RenderTransform>
                </md:PackIcon>
                <TextBlock x:Name="StatusText" Text="Calculating..." Foreground="#F57C00"
                           FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ Log panel — only shown on the Check tab ═══ -->
        <md:Card x:Name="LogCard" Grid.Row="4" Margin="16,0,16,12" Padding="0" md:ElevationAssist.Elevation="Dp1">
            <Expander IsExpanded="True" md:ExpanderAssist.HorizontalHeaderPadding="16"
                      Background="Transparent">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Console" Width="16" Height="16" VerticalAlignment="Center"
                                     Foreground="#78909C" Margin="0,0,8,0"/>
                        <TextBlock Text="Log" Foreground="#78909C"/>
                    </StackPanel>
                </Expander.Header>
                <TextBox x:Name="LogBox" Height="110" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5"
                         Margin="12,0,12,8" Background="#FAFBFC"
                         BorderThickness="0" Foreground="#455A64"/>
            </Expander>
        </md:Card>
    </Grid>
</Window>
